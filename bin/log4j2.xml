<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="[%d{yyyy-MM-dd HH:mm:ss}] [%level] %c - %msg%n"/>
        </Console>

        <File name="SecurityFile" fileName="logs/chrionline-security.log" append="true">
            <PatternLayout pattern="[%d{yyyy-MM-dd HH:mm:ss}] [%level] %c - %msg%n"/>
        </File>
    </Appenders>

    <Loggers>
        <Logger name="SECURITY" level="info" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="SecurityFile"/>
        </Logger>

        <Logger name="SERVER" level="info" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="SecurityFile"/>
        </Logger>

        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="SecurityFile"/>
        </Root>
    </Loggers>
</Configuration>